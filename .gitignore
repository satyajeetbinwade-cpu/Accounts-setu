# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Local database & secrets (never commit) ----
db/
*.db
*.sqlite
*.sqlite3
*.key
.env
*.pem

# ---- Streamlit ----
.streamlit/secrets.toml

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Misc ----
.pytest_cache/
.mypy_cache/
*.log

# ---- Demo module scratch ----
# Ephemeral per-session uploads staged by demo/session.py. Never committed:
# they are throwaway copies of whatever was uploaded to a demo session.
data/_demo/

# ---- Reflex (generated / runtime) ----
# .web/ is the generated frontend build (~200MB), .states/ is runtime state
# serialization, reflex.lock/ is the generated JS dependency lock. All are
# reproduced by `reflex init`/`reflex run` and must never be committed.
.web/
.states/
reflex.lock/
