# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Local database & secrets (never commit) ----
db/
*.db
*.sqlite
*.sqlite3
*.key
.env
*.pem

# ---- UI mockups / real client data — never commit ----
mockups/

# ---- Real client document bundles used as triage fixtures (PII) ----
# The triage fixture PDF is a real client's bundle. It is NEVER committed;
# read its path from the SETU_TRIAGE_FIXTURE_PDF environment variable instead.
tests/fixtures/**/*.pdf

# ---- Invoice triage live-score output (annotated page PNGs + report) ----
reports/invoice_triage/
reports/invoice_extract_v2/
reports/invoice_review_v2/

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Misc ----
.pytest_cache/
.mypy_cache/
*.log

# ---- Reflex (generated / runtime) ----
# .web/ is the generated frontend build (~200MB), .states/ is runtime state
# serialization, reflex.lock/ is the generated JS dependency lock. All are
# reproduced by `reflex init`/`reflex run` and must never be committed.
.web/
.states/
reflex.lock/

# ---- Derived data (re-renderable, never committed) ----
data/_page_cache/
